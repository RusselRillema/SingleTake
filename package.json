{
  "name": "singletake",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Dependency-free, local-first WebGPU architectural modeler",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node tools/check.mjs",
    "audit": "node tools/audit.mjs",
    "build": "node tools/build.mjs",
    "verify": "node tools/verify.mjs",
    "publish": "node tools/publish.mjs",
    "preview": "node server.mjs --dist",
    "desktop:bundle": "node tools/desktop-bundle.mjs",
    "desktop:doctor": "node tools/desktop-doctor.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RusselRillema/SingleTake.git"
  }
}
