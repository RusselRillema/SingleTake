{
  "schemaVersion": "1.0",
  "id": "com.singletake.modeler",
  "displayName": "SingleTake shared workspace",
  "version": "0.4.0",
  "profileVersion": "1.0",
  "entryPoint": "main.js",
  "assets": [
    "main.js",
    "ui/index.html",
    "ui/style.css",
    "ui-source.json"
  ],
  "capabilities": [
    "dom",
    "css.layout",
    "input.pointer",
    "input.keyboard",
    "input.focus",
    "svg",
    "host.commands"
  ],
  "lifecycle": {
    "mountExport": "mount",
    "unmountExport": "unmount"
  }
}
